	<true/>
	<!-- AdMob: the SDK stops the app at launch without this key.
	     This is Google's TEST App ID. Replace it with your iOS App ID from the
	     AdMob console (Apps → Add app → iOS) before releasing on the App Store. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- Shown by the iOS App Tracking Transparency prompt (via AdMob's
	     Privacy & messaging IDFA message). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID can lock your cycle data so only you can see it.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera counts your reps, checks your form and scans food barcodes. Video is analysed on your phone and never recorded or uploaded.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location builds your private daily timeline (places, routes, gym visits). It never leaves your phone.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Your daily step count is shown on your Today screen. It stays on your device.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>BMI Health does not write to Apple Health.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier is used to show you more relevant ads. Your health data never leaves your device.</string>
	<!-- SKAdNetwork IDs for ad attribution. Google's own ID is listed; add the
	     third-party buyer IDs from Google's docs:
	     https://developers.google.com/admob/ios/privacy/strategies -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
