  "adviceUnderHeadline": "Your weight is below the healthy range",
  "@adviceUnderHeadline": {
    "description": "Result headline for BMI category 'under'"
  },
  "adviceUnderCopy": "Being underweight can weaken immunity, reduce bone density, and affect energy levels. The goal is gradual, quality weight gain — not just eating more junk food.",
  "@adviceUnderCopy": {
    "description": "Result intro for BMI category 'under'"
  },
  "adviceUnderStep1": "Eat calorie-dense whole foods: nuts, nut butter, avocado, eggs, whole milk, oats, and brown rice",
  "@adviceUnderStep1": {
    "description": "Action step 1 for BMI category 'under'"
  },
  "adviceUnderStep2": "Add 300–500 extra kcal per day — enough to gain ~0.3–0.5 kg per week sustainably",
  "@adviceUnderStep2": {
    "description": "Action step 2 for BMI category 'under'"
  },
  "adviceUnderStep3": "Eat 3 main meals + 2–3 snacks daily; never skip breakfast",
  "@adviceUnderStep3": {
    "description": "Action step 3 for BMI category 'under'"
  },
  "adviceUnderStep4": "Include protein at every meal — aim for 1.2–1.6 g per kg of body weight to build muscle",
  "@adviceUnderStep4": {
    "description": "Action step 4 for BMI category 'under'"
  },
  "adviceUnderStep5": "Do resistance training 2–3× per week (squats, push-ups, rows) so gained weight becomes muscle, not just fat",
  "@adviceUnderStep5": {
    "description": "Action step 5 for BMI category 'under'"
  },
  "adviceUnderStep6": "If weight loss is unexplained or rapid, see a doctor — it may signal an underlying condition",
  "@adviceUnderStep6": {
    "description": "Action step 6 for BMI category 'under'"
  },
  "adviceUnderNote": "If you have been underweight for a long time, consult a doctor or registered dietitian for personalised support.",
  "@adviceUnderNote": {
    "description": "Medical note for BMI category 'under'"
  },
  "adviceNormalHeadline": "You are in the healthy weight range",
  "@adviceNormalHeadline": {
    "description": "Result headline for BMI category 'normal'"
  },
  "adviceNormalCopy": "A healthy BMI is a great foundation. The priority now is maintaining it through consistent habits — movement, quality nutrition, sleep, and stress management all matter.",
  "@adviceNormalCopy": {
    "description": "Result intro for BMI category 'normal'"
  },
  "adviceNormalStep1": "Get 150–300 min of moderate aerobic activity per week: brisk walking, cycling, or swimming",
  "@adviceNormalStep1": {
    "description": "Action step 1 for BMI category 'normal'"
  },
  "adviceNormalStep2": "Add 2–3 strength training sessions per week to preserve muscle mass as you age",
  "@adviceNormalStep2": {
    "description": "Action step 2 for BMI category 'normal'"
  },
  "adviceNormalStep3": "Fill half your plate with vegetables and fruit at every main meal",
  "@adviceNormalStep3": {
    "description": "Action step 3 for BMI category 'normal'"
  },
  "adviceNormalStep4": "Limit ultra-processed foods, added sugars, and alcohol — they add calories with little nutrition",
  "@adviceNormalStep4": {
    "description": "Action step 4 for BMI category 'normal'"
  },
  "adviceNormalStep5": "Sleep 7–9 hours per night; poor sleep raises ghrelin (hunger hormone) and leads to overeating",
  "@adviceNormalStep5": {
    "description": "Action step 5 for BMI category 'normal'"
  },
  "adviceNormalStep6": "Re-check your BMI every 4–6 weeks to catch any drift early",
  "@adviceNormalStep6": {
    "description": "Action step 6 for BMI category 'normal'"
  },
  "adviceNormalNote": "BMI is a screening tool, not a full health picture. Body composition, blood pressure, and blood sugar also matter.",
  "@adviceNormalNote": {
    "description": "Medical note for BMI category 'normal'"
  },
  "adviceOverHeadline": "Your weight is slightly above the healthy range",
  "@adviceOverHeadline": {
    "description": "Result headline for BMI category 'over'"
  },
  "adviceOverCopy": "Overweight raises the risk of type 2 diabetes, high blood pressure, and joint problems over time. Even a 5–10% reduction in body weight significantly lowers these risks.",
  "@adviceOverCopy": {
    "description": "Result intro for BMI category 'over'"
  },
  "adviceOverStep1": "Create a moderate calorie deficit of 300–500 kcal/day — target 0.3–0.5 kg loss per week (sustainable pace)",
  "@adviceOverStep1": {
    "description": "Action step 1 for BMI category 'over'"
  },
  "adviceOverStep2": "Walk 8,000–10,000 steps daily; start with 30 min brisk walks and build from there",
  "@adviceOverStep2": {
    "description": "Action step 2 for BMI category 'over'"
  },
  "adviceOverStep3": "Swap sugary drinks (soda, juice, energy drinks) for water, sparkling water, or unsweetened tea",
  "@adviceOverStep3": {
    "description": "Action step 3 for BMI category 'over'"
  },
  "adviceOverStep4": "Eat protein first at each meal — it increases satiety and reduces overall calorie intake",
  "@adviceOverStep4": {
    "description": "Action step 4 for BMI category 'over'"
  },
  "adviceOverStep5": "Fill half your plate with non-starchy vegetables (broccoli, spinach, cucumber, peppers) at lunch and dinner",
  "@adviceOverStep5": {
    "description": "Action step 5 for BMI category 'over'"
  },
  "adviceOverStep6": "Avoid eating within 2–3 hours of bedtime — late-night eating promotes fat storage",
  "@adviceOverStep6": {
    "description": "Action step 6 for BMI category 'over'"
  },
  "adviceOverNote": "Crash diets backfire. A 300–500 kcal deficit is enough — losing weight slowly preserves muscle and is easier to maintain.",
  "@adviceOverNote": {
    "description": "Medical note for BMI category 'over'"
  },
  "adviceObeseHeadline": "Your weight is in the obese range",
  "@adviceObeseHeadline": {
    "description": "Result headline for BMI category 'obese'"
  },
  "adviceObeseCopy": "Obesity is associated with increased risk of heart disease, type 2 diabetes, sleep apnea, and joint pain. The good news: even modest weight loss of 5–10% of your body weight produces meaningful health improvements.",
  "@adviceObeseCopy": {
    "description": "Result intro for BMI category 'obese'"
  },
  "adviceObeseStep1": "Set your first target at 5–10% of current weight — for an 100 kg person, that is just 5–10 kg",
  "@adviceObeseStep1": {
    "description": "Action step 1 for BMI category 'obese'"
  },
  "adviceObeseStep2": "Aim for 0.5–1.0 kg loss per week; faster rates typically cause muscle loss and a rebound",
  "@adviceObeseStep2": {
    "description": "Action step 2 for BMI category 'obese'"
  },
  "adviceObeseStep3": "Start with low-impact daily movement: 30 min walking, swimming, or stationary cycling — knees and joints will thank you",
  "@adviceObeseStep3": {
    "description": "Action step 3 for BMI category 'obese'"
  },
  "adviceObeseStep4": "Cut out ultra-processed foods, fried food, and added sugars first — these alone can reduce 500+ kcal/day",
  "@adviceObeseStep4": {
    "description": "Action step 4 for BMI category 'obese'"
  },
  "adviceObeseStep5": "Build meals around protein (chicken, fish, legumes, eggs) and vegetables; they keep you full longer",
  "@adviceObeseStep5": {
    "description": "Action step 5 for BMI category 'obese'"
  },
  "adviceObeseStep6": "See your doctor for a baseline check — blood pressure, blood sugar, and cholesterol — and ask about structured support programs",
  "@adviceObeseStep6": {
    "description": "Action step 6 for BMI category 'obese'"
  },
  "adviceObeseNote": "BMI alone does not diagnose health. Speak with a doctor or registered dietitian for a plan tailored to your medical history.",
  "@adviceObeseNote": {
    "description": "Medical note for BMI category 'obese'"
  },
